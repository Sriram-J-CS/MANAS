# ==============================================================================
# EmotiCare Environment Variables (.env.example)
# NOTE: Empty placeholders only. DO NOT add real secret keys here.
# Copy to .env.local and populate with your production or local credentials.
# ==============================================================================

# Database Connection (Supabase Postgres)
DATABASE_URL=

# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Provider API Key (e.g. OpenAI / Anthropic / Gemini for chat & vision)
AI_PROVIDER_API_KEY=

# Avatar 3D Provider API Key (Optional; leave empty for free vision-based attribute tinting)
AVATAR_PROVIDER_API_KEY=

# Voice / TTS Provider API Key (e.g. ElevenLabs / Sarvam / Cartesia for streaming TTS & viseme timings)
VOICE_PROVIDER_API_KEY=

# Supabase Storage S3-Compatible Configuration
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Media Integrations
YOUTUBE_API_KEY=
MUSIC_PROVIDER_CLIENT_ID=
MUSIC_PROVIDER_CLIENT_SECRET=

# Alternative LLM Providers (if using Anthropic Claude instead of Gemini)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# LLM provider selection: gemini (default) | anthropic
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=15

# Optional: URL for the ONNX fast emotion pre-check sidecar (ml/emotion/serve_onnx.py)
# Leave empty to disable ONNX pre-check (graceful fallback to lexicon-based analysis)
# Example: http://localhost:8009
ONNX_EMOTION_URL=

# PgVector for knowledge embeddings (optional; falls back to BM25 if not set)
PGVECTOR_URL=

# AES-256-GCM encryption keys for zero-PII contact storage
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Twilio / SMS provider (optional, for OTP verification)
TWILIO_ACCOUNT_SID=
SMS_PROVIDER_API_KEY=
