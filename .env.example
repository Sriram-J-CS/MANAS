# ==============================================================================
# EmotiCare AI / MANAS — Production Environment Configuration (.env.example)
# Digital Mental Twin Platform & Emotional Wellness Companion
# NOTE: Placeholders only. Copy to .env and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# Environment: development | production
ENVIRONMENT=development

# JWT Secret Key for Bearer token verification and session encryption
# Generate in production using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars

# Dev OTP Exposure: Set to 0 in production to protect SMS/email OTP codes
# When set to 1 in local development, /api/auth/otp/request includes dev_otp_code
EXPOSE_DEV_OTP=1

# Automated testing flag (bypasses IP rate limiters during automated test suites)
TESTING=0

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL (Production recommended):
# DATABASE_URL=postgresql://emoticare_user:secure_password@localhost:5432/emoticare_db
#
# SQLite (Local development default):
DATABASE_URL=sqlite:///./backend/manas_twin.db

# ------------------------------------------------------------------------------
# 3. AI & LANGUAGE MODEL PROVIDERS
# ------------------------------------------------------------------------------
# Primary LLM Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=15

# Optional: Fast ONNX Emotion Pre-check Sidecar URL (e.g., http://127.0.0.1:8009)
ONNX_EMOTION_URL=

# ------------------------------------------------------------------------------
# 4. MULTILINGUAL VOICE & SPEECH PROVIDERS (8 INDIAN LANGUAGES)
# Languages: en-IN, hi-IN, ta-IN, te-IN, kn-IN, ml-IN, bn-IN, mr-IN
# ------------------------------------------------------------------------------
# Sarvam AI API Key (native Indian language TTS bulbul:v2 / STT saarika:v2.5)
SARVAM_API_KEY=

# Google Cloud Chirp 3 HD Voice Integration (Optional alternative)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-cloud-key.json

# ElevenLabs (Optional alternative voice provider)
# ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (ZERO-RETENTION AVATAR & ENCRYPTED ASSETS)
# ------------------------------------------------------------------------------
# Private S3-Compatible Object Storage (e.g. AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=emoticare-private-vault

# ------------------------------------------------------------------------------
# 6. EXTERNAL HELPLINES & VERIFIED DIRECTORIES
# ------------------------------------------------------------------------------
# India National Tele-Mental Health Programme (Tele-MANAS toll-free 14416)
TELE_MANAS_HELPLINE=14416
EMERGENCY_HELPLINE=112
CHILDLINE_HELPLINE=1098
