# ==============================================================================
# Git Ignore Configuration for MANAS Mental Health Companion
# ==============================================================================

# Strict Security: Never commit environment variables, keys, or credentials
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
service-account*.json
token.json

# Databases & User Data (Local SQLite & Sessions)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/manas_twin.db

# Dependencies
node_modules/
*/node_modules/

# Frontend Builds & Outputs
dist/
*/dist/
dist-ssr/
build/
out/
.next/
.vite/
.turbo/

# Playwright & Test Results
test-results/
*/test-results/
playwright-report/
*/playwright-report/
.playwright/
blob-report/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python caches, virtual environments & compiled bytecode
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Temporary files & OS files
tmp/
temp/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
